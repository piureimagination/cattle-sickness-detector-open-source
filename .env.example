# Copy this file to .env and fill in your own values. Never commit .env.

# Kaggle API credentials used by kagglehub to download the training dataset.
# See https://www.kaggle.com/docs/api for how to generate a token.
KAGGLE_API_TOKEN=

# Where trained model checkpoints are written.
MODEL_SAVE_PATH=models

# Where the training log file is written.
LOG_PATH=models/train.log

# MLflow tracking URI. A plain file store is deprecated in current MLflow
# versions, so this defaults to a local SQLite DB.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
